# Firebase web app config (all values below, including VITE_FIREBASE_API_KEY,
# are PUBLIC by Firebase's own design — safe to embed in a browser bundle.
# They identify which Firebase project to talk to; they are not secrets.
# Real access control is enforced by firebase/firestore.rules,
# firebase/storage.rules, and the Cloud Functions in firebase/functions/,
# never by keeping this configuration hidden.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Web Push certificate (VAPID) public key, from Firebase Console > Project
# Settings > Cloud Messaging > Web configuration > "Web Push certificates".
# Public by the same design as the values above. Required for push
# notifications (Notification permission / subscribeToAlerts) to work;
# leave unset to run without them — the rest of the app is unaffected,
# CaptureButtons/etc. do not depend on this, and NotificationSettings.tsx
# shows "not available on this deployment" rather than failing loudly.
VITE_FIREBASE_VAPID_KEY=

# Firebase App Check (reCAPTCHA v3 SITE key — also public by design; the
# paired secret key lives only on Google's servers and is configured in the
# Firebase Console, never in this app). See ABUSE_PROTECTION_REPORT.md.
# Leave unset to run without App Check (e.g. local development); the app
# degrades gracefully, but Cloud Functions/Firestore/Storage should have
# App Check enforcement OFF in that case too, or requests will be rejected.
VITE_RECAPTCHA_SITE_KEY=
