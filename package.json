{
  "name": "tracenet-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:pwa": "vitest run --config vitest.pwa.config.ts",
    "test:security": "npx firebase-tools emulators:exec --project tracenet-emulator-test --only firestore,storage \"npx vitest run --config firebase/emulator-tests/vitest.config.ts\""
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "firebase": "^11.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4",
    "workbox-background-sync": "^7.1.0",
    "workbox-core": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  }
}
